# Do Events — server settings for Hostinger (Apache/LiteSpeed)

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------
# Rewrites
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS (the X-Forwarded-Proto check avoids loops behind Hostinger's proxy/CDN)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Keep the build tools, docs and git metadata private
  RewriteRule ^(build|\.git|\.claude)(/|$) - [R=404,L]
  RewriteRule ^(README\.md|\.gitignore|\.gitattributes|\.htaccess)$ - [R=404,L]
</IfModule>

# ---------------------------------------------------------------
# Correct types for the site's media
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType audio/mpeg .mp3
  AddType image/svg+xml .svg
</IfModule>

# ---------------------------------------------------------------
# Compression for text assets (media is already compressed)
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/x-javascript text/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# Browser caching
#   CSS/JS links carry a ?v=<content-hash>, so they can be cached for a year.
#   Pages are always re-checked so updates show immediately.
# ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType audio/mpeg "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|mp4|mp3)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Basic security headers (embedding YouTube films and Google Maps is unaffected)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
